# ====================================================================
# CivicFix AI — Environment Variables
# Copy this file to .env.local or set variables in your Vercel deployment
# ====================================================================

# Supabase Project URL and Anon Public Key (Found in Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# Optional: Mapbox or custom tile server (Leaflet defaults to free OpenStreetMap tiles)
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional: External AI Provider key (The application comes with transparent built-in rule-based AI triage)
# VITE_AI_API_KEY=your_optional_llm_key
